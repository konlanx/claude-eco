{
  "name": "claude-eco",
  "version": "0.1.0",
  "description": "Display real-time energy, water, and CO₂ metrics in the Claude Code statusline, derived from live token counts.",
  "license": "MIT",
  "bin": {
    "claude-eco": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
